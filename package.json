{
  "name": "gopher-calendar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension for UMN students: Canvas deadlines and MyU class times in one semester calendar.",
  "scripts": {
    "test": "node --test test/*.test.js",
    "vendor": "cp node_modules/pdfjs-dist/build/pdf.min.mjs node_modules/pdfjs-dist/build/pdf.worker.min.mjs extension/vendor/",
    "preview": "node dev/build-preview.mjs && python3 dev/serve.py",
    "eval": "node dev/eval-rules.mjs",
    "build:demo": "node demo/build.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "linkedom": "^0.18.13",
    "pdfjs-dist": "6.3.289"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kenny2077/Gopher-Calendar.git"
  },
  "engines": {
    "node": ">=20"
  }
}
